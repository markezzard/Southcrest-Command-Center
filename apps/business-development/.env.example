# Sanctioned Google Sheets write/read path for SPI Relationship Master.
# Do not commit real credentials. Share the sheet with the service account email.

# Preferred: full service-account JSON as a single line (or heredoc in a secret manager).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative: path to a local JSON key file (never commit the file).
GOOGLE_APPLICATION_CREDENTIALS=

# Optional override. Defaults to the live SPI Relationship Master in 01_Project Controls.
SPI_RELATIONSHIP_MASTER_SHEET_ID=1mE1Y2vJ5uKRW-VcQ6oMs9yUhmlwc-q91vXlFp7caMCg

# Workbench "today" and stale-contact math. Company operates in Eastern Time.
BD_TIMEZONE=America/New_York
BD_STALE_CONTACT_DAYS=30
